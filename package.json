{
  "name": "noir-shield",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "build": "node scripts/build.mjs",
    "refresh": "node scripts/build.mjs --refresh",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "e2e": "node tests/e2e.mjs",
    "test:youtube": "node tests/youtube-e2e.mjs",
    "test:youtube:live": "node tests/youtube-live.mjs",
    "test:youtube:lab": "node tests/youtube-lab-e2e.mjs",
    "test:youtube:probes": "node tests/youtube-probe-e2e.mjs",
    "test:live:audit": "node tests/live-audit.mjs",
    "test:live:navigation": "node tests/live-navigation.mjs",
    "test:youtube:long": "node tests/long-session.mjs",
    "test:youtube:formats": "node tests/formats-session.mjs",
    "test:youtube:midroll": "node tests/midroll-hidden.mjs",
    "test:youtube:chrome": "powershell -NoProfile -File tests/run-chrome.ps1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.321",
    "esbuild": "^0.25.12",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3"
  }
}
